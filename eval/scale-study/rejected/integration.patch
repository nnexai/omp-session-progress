+// Only forecasts made while opted in may become history. A superseded or
+// aborted prompt never supplies a duration label, and branch changes forget all.
+const ages = [15, 60, 180, 450, 900];
+const clamp = (v:number, bound:number) => Math.max(-bound, Math.min(bound,v));
+export class HorizonHistory {
+  private current: ({age:number; seconds:number}|null)[] = [];
+  private recent: (number|null)[][] = [];
+  private pooled = new Float64Array(3*ages.length);
+
+  capture(age:number, seconds:number):void {
+    while (this.current.length<ages.length && age>=ages[this.current.length]!) {
+      const landmark=ages[this.current.length]!;
+      // Never relabel a mid-session opt-in estimate as one made minutes earlier.
+      this.current.push(age-landmark<=5 ? {age,seconds} : null);
+    }
+  }
+  finish(seconds:number, completed:boolean):void {
+    if (completed && seconds>5) {
+      this.recent.push(this.current.map(a=>a?clamp(Math.log((Math.max(0,seconds-a.age)+30)/(a.seconds+30)),2.5):null));
+      if(this.recent.length>8)this.recent.shift();
+      this.pooled.fill(0);
+      for(let j=0;j<ages.length;j++){
+        let count=0,sum=0,last=0;
+        for(let i=this.recent.length-1;i>=0&&count<4;i--){const v=this.recent[i]![j];if(v==null)continue;if(!count)last=v;count++;sum+=v;}
+        if(count)this.pooled.set([sum/count,last,count/4],3*j);
+      }
+    }
+    this.current=[];
+  }
+  append(to:number[],base:number):void {
+    for(let i=0;i<ages.length;i++){
+      const a=this.current[i];to.push(this.pooled[3*i]!,this.pooled[3*i+1]!,this.pooled[3*i+2]!,a?clamp(Math.log((base+30)/(a.seconds+30)),3):0);
+    }
+  }
+}
