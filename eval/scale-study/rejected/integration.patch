+import data from './horizon-data.json';
+import { addWorkShape } from './work-shape';
+import type { Facts } from './facts';
+import type { HorizonHistory } from './horizon-history';
+
+const knots=[-4,-3,-2,-1.4,-.9,-.45,0,.45,.9,1.4,2,2.7,3.5,4.3];
+const shape=knots.slice(1,-1).map(Math.tanh);
+const mid=knots.slice(1).map((v,i)=>Math.exp((knots[i]!+v)/2));
+const sigmoid=(x:number)=>1/(1+Math.exp(-x));
+const clamp=(x:number,lo:number,hi:number)=>Math.min(hi,Math.max(lo,x));
+
+/** Predict a distribution of remaining/control ratios, then choose a point
+ * accounting for the cost of missing long jobs. Never changes short tasks. */
+export function horizonSeconds(base:number,age:number,x:number[],facts:Facts,history?:HorizonHistory):number {
+  if(age<=450)return base;
+  const le=Math.log1p(age/60), lb=Math.log1p(base/60);
+  const v=[le,lb,lb-le,Math.max(0,le-1.4),Math.max(0,le-2.7),Math.max(0,lb-1.6)];
+  for(const i of data.base)v.push(x[i]!);
+  addWorkShape(v,facts,age);
+  if(history)history.append(v,base);else for(let i=0;i<20;i++)v.push(0);
+  let center=0,skew=0;
+  for(let j=0;j<v.length;j++){
+    const n=clamp((v[j]!-data.mu[j]!)/data.sd[j]!,-4,4);
+    center+=n*data.beta[j]!;skew+=n*data.skew[j]!;
+  }
+  // Store both arrays in the now-unused feature scratch; no per-bin allocations.
+  let previous=0,pLong=0,pHalf=0;
+  for(let i=0;i<mid.length;i++){
+    const cdf=i===shape.length?1:Math.max(previous,sigmoid(-center-skew*shape[i]!-data.intercept[i]!));
+    const mass=cdf-previous;previous=cdf;
+    const total=age+Math.max(0,(base+30)*mid[i]!-30);
+    const long=sigmoid((total-900)/120), half=sigmoid((total-1800)/240);
+    pLong+=mass*long;pHalf+=mass*half;v[i]=mass;v[mid.length+i]=long+half;
+  }
+  const premium=5*clamp((pLong+.5*pHalf-.20)/.5,0,1);
+  let target=.55*(1+premium*(pLong+pHalf));
+  for(let i=0;i<mid.length;i++){
+    const mass=v[i]!*(1+premium*v[mid.length+i]!);
+    if(target<=mass && mass>0){
+      const logRatio=knots[i]!+(knots[i+1]!-knots[i]!)*target/mass;
+      const ratio=Math.max(30/(base+30),Math.exp(logRatio));
+      return Math.max(0,(base+30)*clamp(ratio,.2,5)**Math.min(1,(age-450)/450)-30);
+    }
+    target-=mass;
+  }
+  return base;
+}
